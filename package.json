{
  "name": "claim-cause",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/export-data.mjs",
    "build": "next build",
    "build:pages": "node scripts/export-data.mjs && GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH=/ActivistDB next build",
    "start": "next start",
    "test": "node scripts/validate-data.mjs && pnpm build:pages && node --test tests/*.test.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "research:watch": "node scripts/research-watch.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern out --ignore-pattern artifacts",
    "verify": "pnpm lint && pnpm test"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
